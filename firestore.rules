rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Organisations ────────────────────────────────────────────────────────
    match /orgs/{orgId} {

      // Members can read their own org document by ID.
      allow get: if request.auth != null
        && resource.data.members[request.auth.uid] != null;

      // Non-anonymous users can run collection queries (required for the
      // invite-code lookup: db.collection('orgs').where('inviteCode','==',code)).
      // Note: this allows querying org metadata (name, members list) but NOT
      // the data subcollection. Upgrade to Cloud Functions if org metadata
      // must remain private.
      allow list: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';

      // Billing fields are written only by Cloud Functions via the Admin SDK
      // (which bypasses these rules entirely) — never by a client. Listed
      // once here and reused by the create/update rules below.
      function billingFields() {
        return ['plan', 'subscriptionStatus', 'stripeCustomerId', 'stripeSubscriptionId', 'currentPeriodEnd'];
      }

      // Lifetime usage counters (see the dedicated increment-only rule below).
      // Excluded from the owner's general update rule too, so ownership can't
      // be used as a backdoor around the increment-only constraint.
      function counterFields() {
        return ['lifetimeEntryCount', 'lifetimeInvoiceCount'];
      }

      // Any authenticated user may create an org for themselves (anonymous
      // users get their own private workspace). The creator must be set as
      // ownerId and must be present in the members map. Billing fields may
      // not be set on create — a new org always starts on the free plan by
      // simply having none of these fields.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] != null
        && !request.resource.data.keys().hasAny(billingFields());

      // Only the current owner may update org fields. ownerId is immutable —
      // ownership cannot be transferred by a simple client-side write.
      // Billing fields can never be touched by this rule (Cloud Functions
      // only, via the Admin SDK), and the lifetime counters must go through
      // the dedicated increment-only rule below, not this general one.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(billingFields().concat(counterFields()));

      // Lifetime usage counters that gate the free tier (entries/invoices
      // created). Any member may bump them (any member can create entries),
      // but a value may only ever increase — this is what stops a user from
      // deleting entries/invoices to duck back under the free-tier limit,
      // even via a direct Firestore write rather than the app's own UI.
      allow update: if request.auth != null
        && resource.data.members[request.auth.uid] != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lifetimeEntryCount', 'lifetimeInvoiceCount'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifetimeEntryCount'])
            || request.resource.data.lifetimeEntryCount > resource.data.get('lifetimeEntryCount', 0))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifetimeInvoiceCount'])
            || request.resource.data.lifetimeInvoiceCount > resource.data.get('lifetimeInvoiceCount', 0));

      // Self-join via invite code: a non-anonymous user may add only themselves
      // to the members map when an inviteCode is present, without modifying
      // any other field (including ownerId or inviteCode). The role written
      // for their own entry is pinned to 'member' — otherwise a self-joining
      // user could write role: 'owner' for themselves (the diff/removedKeys
      // checks only constrain which key changes, not the value written to it).
      allow update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.inviteCode != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members.diff(resource.data.members).removedKeys().size() == 0
        && request.resource.data.members[request.auth.uid].role == 'member'
        && request.resource.data.ownerId == resource.data.ownerId;

      // Only the owner may delete the org.
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;

      // Shared gate for every org-scoped subcollection below: the caller
      // must be a member of this org, per the org doc's own members map —
      // never the user's self-declared orgId field, which they could
      // freely rewrite to point at someone else's org (BOLA/IDOR).
      function isOrgMember() {
        return request.auth != null
          && get(/databases/$(database)/documents/orgs/$(orgId)).data.members[request.auth.uid] != null;
      }

      // Legacy single-blob doc (orgs/{orgId}/data/main), pre-subcollection
      // migration. Kept readable/writable during the migration window so
      // any client still on the old code path keeps working; safe to
      // delete this block once data/main has been removed for every org
      // (see functions/scripts/migrate-to-subcollections.js --delete-old).
      match /data/{docId} {
        allow read, write: if isOrgMember();
      }

      // ── Per-entity subcollections ───────────────────────────────────────
      match /customers/{customerId} {
        allow read, write: if isOrgMember();
      }

      match /entries/{entryId} {
        allow read, write: if isOrgMember();
      }

      match /expenses/{expenseId} {
        allow read, write: if isOrgMember();
      }

      match /invoices/{invoiceId} {
        allow read, write: if isOrgMember();
      }

      match /settings/{docId} {
        allow read, write: if isOrgMember();
      }
    }
  }
}
