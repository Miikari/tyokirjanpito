rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Organisations ────────────────────────────────────────────────────────
    match /orgs/{orgId} {

      // Members can read their own org document by ID.
      allow get: if request.auth != null
        && resource.data.members[request.auth.uid] != null;

      // Deliberately no `allow list` — the invite-code lookup used to run as
      // a direct client query (db.collection('orgs').where('inviteCode','==',
      // code)), which required making the whole collection list-able to any
      // authenticated user. That exposed every org's members/inviteCode/
      // billing fields to bulk enumeration, not just the one org being
      // looked up. That lookup (and the actual join) now goes through the
      // lookupOrgByInviteCode / joinOrgByInviteCode Cloud Functions instead,
      // which query via the Admin SDK and bypass these rules entirely
      // (2026-08-04 security review).

      // Billing fields are written only by Cloud Functions via the Admin SDK
      // (which bypasses these rules entirely) — never by a client. Listed
      // once here and reused by the create/update rules below. Includes the
      // referral-reward bookkeeping fields: without this, an org's own owner
      // could write themselves an arbitrary pendingReferralCreditCents (real
      // money off their next Stripe invoice) or reset referralRewardGranted
      // to trigger a re-payout, via a direct Firestore write. referralCode
      // is included too — a client free to set its own to any string could
      // copy another org's code and hijack the reward meant for it; it's
      // generated by the ensureReferralCode Cloud Function instead, which
      // checks for collisions first.
      function billingFields() {
        return ['plan', 'subscriptionStatus', 'stripeCustomerId', 'stripeSubscriptionId', 'currentPeriodEnd',
                'pendingReferralCreditCents', 'referralRewardGranted', 'referralCode'];
      }

      // Lifetime usage counters (see the dedicated increment-only rule below).
      // Excluded from the owner's general update rule too, so ownership can't
      // be used as a backdoor around the increment-only constraint.
      function counterFields() {
        return ['lifetimeEntryCount', 'lifetimeInvoiceCount'];
      }

      // Any authenticated user may create an org for themselves (anonymous
      // users get their own private workspace). The creator must be set as
      // ownerId and must be present in the members map. Billing fields may
      // not be set on create — a new org always starts on the free plan by
      // simply having none of these fields.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] != null
        && !request.resource.data.keys().hasAny(billingFields());

      // Only the current owner may update org fields. ownerId is immutable —
      // ownership cannot be transferred by a simple client-side write.
      // Billing fields can never be touched by this rule (Cloud Functions
      // only, via the Admin SDK), and the lifetime counters must go through
      // the dedicated increment-only rule below, not this general one.
      // inviteCode is excluded too — regenerating it now goes through the
      // regenerateInviteCode Cloud Function, which checks for collisions
      // against every other org's code before writing; a client able to set
      // its own inviteCode directly could pick a short/predictable one or
      // collide with another org's code with no check at all (2026-08-04
      // security review).
      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(billingFields().concat(counterFields()).concat(['inviteCode']));

      // Lifetime usage counters that gate the free tier (entries/invoices
      // created). Any member may bump them (any member can create entries),
      // but a value may only ever increase — this is what stops a user from
      // deleting entries/invoices to duck back under the free-tier limit,
      // even via a direct Firestore write rather than the app's own UI.
      allow update: if request.auth != null
        && resource.data.members[request.auth.uid] != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lifetimeEntryCount', 'lifetimeInvoiceCount'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifetimeEntryCount'])
            || request.resource.data.lifetimeEntryCount > resource.data.get('lifetimeEntryCount', 0))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifetimeInvoiceCount'])
            || request.resource.data.lifetimeInvoiceCount > resource.data.get('lifetimeInvoiceCount', 0));

      // No client-side self-join rule here anymore — the old version only
      // checked that the org HAD an inviteCode set, never that the caller
      // actually supplied the correct one (resource.data.inviteCode != null
      // says nothing about what code the client submitted). That meant
      // anyone who learned or guessed an orgId could add themselves as a
      // member with zero knowledge of the real invite code. Joining now
      // only happens through the joinOrgByInviteCode Cloud Function, which
      // verifies the code server-side via the Admin SDK before writing
      // members (2026-08-04 security review).

      // Only the owner may delete the org.
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;

      // Shared gate for every org-scoped subcollection below: the caller
      // must be a member of this org, per the org doc's own members map —
      // never the user's self-declared orgId field, which they could
      // freely rewrite to point at someone else's org (BOLA/IDOR).
      function isOrgMember() {
        return request.auth != null
          && get(/databases/$(database)/documents/orgs/$(orgId)).data.members[request.auth.uid] != null;
      }

      // Legacy single-blob doc (orgs/{orgId}/data/main), pre-subcollection
      // migration. Kept readable/writable during the migration window so
      // any client still on the old code path keeps working; safe to
      // delete this block once data/main has been removed for every org
      // (see functions/scripts/migrate-to-subcollections.js --delete-old).
      match /data/{docId} {
        allow read, write: if isOrgMember();
      }

      // ── Per-entity subcollections ───────────────────────────────────────
      match /customers/{customerId} {
        allow read, write: if isOrgMember();
      }

      match /entries/{entryId} {
        allow read, write: if isOrgMember();
      }

      match /expenses/{expenseId} {
        allow read, write: if isOrgMember();
      }

      match /invoices/{invoiceId} {
        allow read, write: if isOrgMember();
      }

      match /settings/{docId} {
        allow read, write: if isOrgMember();
      }
    }

    // ── Feature idea board ──────────────────────────────────────────────────
    // Deliberately top-level, not nested under an org — this is shared
    // product feedback across every org, not per-business bookkeeping data.
    match /featureIdeas/{ideaId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && (!request.resource.data.keys().hasAny(['voters']) || request.resource.data.voters.size() == 0);

      // Voting only: anyone may toggle their own key in the voters map, and
      // nothing else about the idea (text, author, other people's votes) —
      // mirrors the org self-join rule's "diff affectedKeys hasOnly(own uid)"
      // pattern above. get('voters', {}) defaults to an empty map for an
      // idea's very first vote, when the field doesn't exist yet on
      // resource.data — a bare resource.data.voters would error out then.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voters'])
        && request.resource.data.voters.diff(resource.data.get('voters', {})).affectedKeys().hasOnly([request.auth.uid]);
    }
  }
}
