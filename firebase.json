{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "functions/**",
      "node_modules/**",
      ".claude/**",
      ".agents/**",
      "keys",
      "skills-lock.json",
      "README.md",
      "tietosuoja/**"
    ]
  }
}
